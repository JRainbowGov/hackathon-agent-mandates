APP_NAME=agent-mandate-hack
AWS_REGION=eu-west-2
ENVIRONMENT=local
REPO=agent-mandate-hack


SENTRY_DSN="dummy-dsn"



APP_URL=http://localhost:3000
AUTH_API_URL=<auth_api_url>


BACKEND_URL=http://localhost:8000


AWS_ACCOUNT_ID=<account_id>
GATEWAY_URL=http://localhost:8082

# optional: lets the gateway, or your agent, call a model
LITELLM_KEY=
LITELLM_BASE_URL=

# dev-only audit store and tracing (docker-compose.observability.yaml, make obs_up).
# Placeholders: change them locally, never commit real values. The gateway connects as GATEWAY_DB_USER,
# which can only append to audit_events; POSTGRES_USER owns the schema.
POSTGRES_DB=gateway
POSTGRES_USER=gateway_owner
POSTGRES_PASSWORD=change-me-owner
GATEWAY_DB_USER=gateway_app
GATEWAY_DB_PASSWORD=change-me-gateway
# host ports, bound to 127.0.0.1 only
POSTGRES_HOST_PORT=55432
JAEGER_UI_PORT=16686
